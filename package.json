{
  "name": "mockingbird",
  "productName": "Mockingbird",
  "version": "1.4.8",
  "description": "Grid manager for parallel Claude CLI sessions — worktrees, status, broadcast, ADO & WorkTracker integration",
  "repository": "github:RyansCode-hue/Mockingbird",
  "main": "dist/main.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "postinstall": "electron-builder install-app-deps && chmod +x node_modules/node-pty/prebuilds/*/spawn-helper node_modules/node-pty/build/Release/spawn-helper 2>/dev/null || true",
    "typecheck": "tsc --noEmit && tsc --noEmit -p signaling",
    "start": "npm run build && electron .",
    "ui-preview": "node scripts/ui-preview.mjs",
    "team:signaling": "node scripts/team-signaling.mjs",
    "team:fingerprint": "node scripts/team-fingerprint.mjs",
    "team:e2e-fingerprint": "node scripts/team-fingerprint.mjs --e2e",
    "icon": "electron scripts/make-icon.js && bash scripts/make-icns.sh",
    "package": "npm run build && electron-builder --mac",
    "package:app": "npm run build && electron-builder --mac --dir",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Ryan Ellerbroek",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.12.0",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.ryanellerbroek.mockingbird",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "directories": {
      "output": "release"
    }
  }
}
